<Page x:Class="TRPO.ElectronicsStore.Pages.CatalogPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Каталог" Loaded="Page_Loaded">
 <Grid x:Name="ContentRoot" Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <Button DockPanel.Dock="Right" Content="Выйти" Click="Logout_Click" Margin="8,0,0,0"/>
   <TextBlock x:Name="RoleText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
   <TextBlock Text="Каталог товаров" Style="{StaticResource Heading}" Margin="0"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Поиск по названию"/><TextBox x:Name="SearchBox" TextChanged="Filters_Changed" AutomationProperties.Name="Поиск по названию"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Категория"/><ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filters_Changed" AutomationProperties.Name="Категория"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Бренд"/><ComboBox x:Name="BrandBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filters_Changed" AutomationProperties.Name="Бренд"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Цена от"/><TextBox x:Name="PriceFromBox" TextChanged="Filters_Changed" AutomationProperties.Name="Цена от"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Цена до"/><TextBox x:Name="PriceToBox" TextChanged="Filters_Changed" AutomationProperties.Name="Цена до"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,8,0">
    <TextBlock Text="Сортировка"/>
    <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="Сортировка">
     <ComboBoxItem Content="Название: А → Я"/><ComboBoxItem Content="Цена: по возрастанию"/>
     <ComboBoxItem Content="Цена: по убыванию"/><ComboBoxItem Content="Остаток: по возрастанию"/>
     <ComboBoxItem Content="Остаток: по убыванию"/>
    </ComboBox>
   </StackPanel>
   <Button Grid.Column="3" Content="Сбросить" VerticalAlignment="Bottom" Margin="0" Click="ResetFilters_Click"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,5,0,6">
   <TextBlock x:Name="FilterError" Style="{StaticResource ErrorText}"/>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
   <WrapPanel x:Name="ManagerActions" Margin="0,6,0,0" Visibility="Collapsed">
    <Button Content="Добавить товар" Click="AddProduct_Click"/>
    <Button Content="Изменить" x:Name="EditButton" IsEnabled="False" Click="EditProduct_Click"/>
    <Button Content="Удалить" x:Name="DeleteButton" IsEnabled="False" Click="DeleteProduct_Click"/>
    <Button Content="Справочники" Style="{StaticResource SecondaryButton}" Click="Directories_Click"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="4">
   <ListBox x:Name="ProductList" Background="Transparent" BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
      HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource ProductCard}"
      SelectionChanged="ProductList_SelectionChanged" MouseDoubleClick="ProductList_MouseDoubleClick" AutomationProperties.Name="Товары">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="SelectionOutline" BorderBrush="Transparent" BorderThickness="2" Padding="2">
          <ContentPresenter HorizontalAlignment="Stretch"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionOutline" Property="BorderBrush" Value="{StaticResource Secondary}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionOutline" Property="BorderBrush" Value="{StaticResource Secondary}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
   <TextBlock x:Name="EmptyText" Text="Товары не найдены" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" IsHitTestVisible="False"/>
  </Grid>
  <DockPanel Grid.Row="5" Margin="0,8,0,0">
   <Button DockPanel.Dock="Right" Content="Обновить" Margin="8,0,0,0" Click="ReloadProducts_Click" Style="{StaticResource SecondaryButton}"/>
   <TextBlock x:Name="CountText" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Page>
