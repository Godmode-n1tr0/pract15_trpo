<Page x:Class="TRPO.ElectronicsStore.Pages.DirectoriesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Справочники" Loaded="Page_Loaded">
 <Grid x:Name="ContentRoot" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Справочники" Style="{StaticResource Heading}"/>
  <TabControl x:Name="DirectoryTabs" Grid.Row="1" Height="40" Margin="0,0,0,16" SelectionChanged="DirectoryTabs_SelectionChanged">
   <TabItem Header="Категории" Padding="18,6"/><TabItem Header="Бренды" Padding="18,6"/><TabItem Header="Теги" Padding="18,6"/>
  </TabControl>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="DirectoryList" SelectionChanged="DirectoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Записи справочника">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="10,8"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Column="2">
    <TextBlock x:Name="EditorTitle" Text="Добавление записи" FontSize="18" Margin="0,0,0,16"/>
    <TextBlock Text="Название *" Style="{StaticResource FilterLabel}"/>
    <TextBox x:Name="NameInput" MaxLength="100" Margin="0,0,0,16" AutomationProperties.Name="Название записи справочника"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="SaveButton" Content="Добавить" Margin="0" Click="SaveItem_Click" IsEnabled="False"/>
     <Button Grid.Column="2" Content="Новая запись" Margin="0" Click="NewItem_Click" Style="{StaticResource SecondaryButton}"/>
     <Button Grid.Row="2" x:Name="DeleteButton" Content="Удалить" Margin="0" Click="DeleteItem_Click" IsEnabled="False"/>
    </Grid>
    <TextBlock x:Name="StatusText" Style="{StaticResource StatusMessage}" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0">
   <Button Content="Назад в каталог" Width="168" Click="Back_Click" Style="{StaticResource SecondaryButton}"/>
   <Button Content="Обновить список" Width="168" Margin="0" Click="ReloadItems_Click" Style="{StaticResource SecondaryButton}"/>
  </WrapPanel>
 </Grid>
</Page>
