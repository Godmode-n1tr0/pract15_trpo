<Page x:Class="TRPO.ElectronicsStore.Pages.ProductFormPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Товар" Loaded="Page_Loaded">
 <Grid x:Name="ContentRoot" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Название *" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Название товара"/>
    <TextBlock Text="Описание *" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Описание товара"/>
    <TextBlock Text="Категория *" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Категория товара"/>
    <TextBlock Text="Бренд *" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="BrandBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Бренд товара"/>
    <TextBlock Text="Дата создания * (дд.мм.гггг)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="DateInput" MaxLength="10" AutomationProperties.Name="Дата создания в формате дд.мм.гггг"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="Цена * (₽)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" AutomationProperties.Name="Цена товара"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Остаток *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" AutomationProperties.Name="Остаток товара"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Рейтинг * (0–5)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RatingText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Рейтинг товара"/></StackPanel>
    </Grid>
    <TextBlock Text="Теги (необязательно)" Style="{StaticResource FieldLabel}"/>
    <ListBox x:Name="TagsList" Height="152" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Теги товара">
     <ListBox.ItemTemplate><DataTemplate>
      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="* — обязательное поле" Margin="0,12,0,0"/>
    <TextBlock x:Name="LoadStatus" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
  <WrapPanel Grid.Row="2" Margin="0,16,0,0">
   <Button x:Name="SaveButton" Content="Сохранить" Width="136" IsEnabled="False" Click="SaveProduct_Click"/>
   <Button Content="Отмена" Width="136" Click="CancelEdit_Click" Style="{StaticResource SecondaryButton}"/>
   <Button x:Name="RetryButton" Content="Загрузить справочники" Width="220" Margin="0" Click="ReloadLists_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButton}"/>
  </WrapPanel>
 </Grid>
</Page>
