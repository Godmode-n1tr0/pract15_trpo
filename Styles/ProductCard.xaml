<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:TRPO.ElectronicsStore.UI">
 <ui:StockBorderConverter x:Key="StockBorder"/>
 <DataTemplate x:Key="ProductCard">
  <Border Background="White" BorderThickness="1" Padding="12,8"
          BorderBrush="{Binding Stock, Converter={StaticResource StockBorder}}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Name}" FontSize="26" TextWrapping="Wrap" Margin="0,0,12,0"/>
    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N2} ₽}" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal">
     <TextBlock Text="☆" Foreground="#F4B400" FontSize="25" Margin="0,0,4,0"/>
     <TextBlock Text="{Binding Rating, StringFormat={}{0:0.0}}" FontFamily="Georgia" FontSize="23" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Category.Name}" TextWrapping="Wrap" FontSize="20" Margin="0,20,0,0"/>
    <TextBlock Grid.Row="3" Text="{Binding Description}" TextWrapping="Wrap" FontSize="20" Margin="0,20,12,0"/>
    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Stock, StringFormat=Остаток: {0}}" FontSize="20" Margin="0,20,0,0" HorizontalAlignment="Right"/>
    <ItemsControl Grid.Row="4" Grid.ColumnSpan="2" ItemsSource="{Binding Tags}" Margin="0,20,0,0">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat=#{0}}" FontSize="20" Padding="0,0,5,0" TextWrapping="Wrap" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
 </DataTemplate>
</ResourceDictionary>
