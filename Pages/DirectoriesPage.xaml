<Page x:Class="TRPO.ElectronicsStore.Pages.DirectoriesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Справочники" Loaded="Page_Loaded">
 <Grid x:Name="ContentRoot" Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Справочники" Style="{StaticResource Heading}"/>
  <TabControl x:Name="DirectoryTabs" Grid.Row="1" Height="40" Margin="0,0,0,8" SelectionChanged="DirectoryTabs_SelectionChanged">
   <TabItem Header="Категории" Padding="18,6"/><TabItem Header="Бренды" Padding="18,6"/><TabItem Header="Теги" Padding="18,6"/>
  </TabControl>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="DirectoryList" SelectionChanged="DirectoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Записи справочника">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Column="2">
    <TextBlock x:Name="EditorTitle" Text="Добавление записи" FontSize="18" Margin="0,0,0,12"/>
    <TextBlock Text="Название *"/><TextBox x:Name="NameInput" MaxLength="100" Margin="0,4,0,12" AutomationProperties.Name="Название записи справочника"/>
    <WrapPanel>
     <Button x:Name="SaveButton" Content="Добавить" Click="SaveItem_Click" IsEnabled="False"/>
     <Button Content="Новая запись" Click="NewItem_Click" Style="{StaticResource SecondaryButton}"/>
     <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteItem_Click" IsEnabled="False" Margin="0,8,8,0"/>
    </WrapPanel>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0">
   <Button Content="Назад в каталог" Click="Back_Click" Style="{StaticResource SecondaryButton}"/>
   <Button Content="Обновить список" Click="ReloadItems_Click" Style="{StaticResource SecondaryButton}"/>
  </WrapPanel>
 </Grid>
</Page>
